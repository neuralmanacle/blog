# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# system files
.DS_Store
**/.DS_Store

# dependencies
/node_modules

# next.js
/.next/
/out/

# production
/build

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Ignore ALL parent directory files and folders
../../*
../*

# Ignore specific file types in parent directories
../*.pdf
../*.jpg
../*.jpeg
../*.png
../*.webp

# Ignore system and config files
../../.*
../.*

# Ignore common directories
../../Documents/
../../Downloads/
../../Library/
../../Applications/
../../Projects/
../../Pictures/
../../Movies/
../../Music/
../../Public/
../../.CFUserTextEncoding
../../.bash_history
../../.zsh_history
../Resume.pdf

# Local drafts
/drafts/*
!/drafts/step-09-drizel-playable-granular-instrument-explained.md
!/drafts/step-10-offline-sample-analysis.md
!/drafts/step-11-teaching-drizel-where-to-start-a-grain.md

